{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dialogato",
  "compatibility_date": "2026-10-06",
  // Static export only: serve out/ as assets, no Worker script
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  // Branch previews (Workers Builds runs wrangler preview)
  "previews": {}
}
